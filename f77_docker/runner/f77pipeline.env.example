# OCI image used when creating the immutable Apptainer SIF.
# Pin an image digest for production after publishing, for example:
# OCI_IMAGE_URI=ghcr.io/OWNER/REPOSITORY@sha256:...
OCI_IMAGE_URI=ghcr.io/OWNER/REPOSITORY:gnu4.8.5
F77_SIF=/shared/path/to/f77pipeline-gnu4.8.5.sif

# The source and data paths must be visible at the same host path on every
# allocated compute node.
F77_SOURCE_HOST=/path/to/code
F77_SOURCE_CONTAINER=/workspace/f77

ASTROMETRY_CAT_HOST=/path/to/astrometry/catalog
ASTROMETRY_CAT_CONTAINER=/data/catalogs/AstroDir

SOURCE_CAT_HOST=/path/to/source/catalog
SOURCE_CAT_CONTAINER=/data/catalogs/ExtSrcDir

FLAT_PATH_HOST=/path/to/flat/calibration
FLAT_PATH_CONTAINER=/data/calib/FlatDir

PROCESS_DATA_HOST=/path/to/processing/data
PROCESS_DATA_CONTAINER=/data/DataProcess
F77_EXPO_LIST_CONTAINER="${PROCESS_DATA_CONTAINER%/}/expo_list.list"

# A shared writable filesystem used only by mpi-smoke-test.slurm. The script
# creates and removes a unique job directory below this path.
HPC_SHARED_SCRATCH_HOST="${PROCESS_DATA_HOST}"

# Leave APPTAINER_BIN empty to auto-detect apptainer or singularity.
APPTAINER_BIN=

# Optional comma-separated Apptainer bind specifications. Keep this empty
# unless compute-node tests show that host RDMA/provider files must be exposed.
# Example syntax: /host/path:/same/container/path:ro,/host/dir:/host/dir:ro
HPC_EXTRA_BINDS=

# Optional libfabric selection for site diagnostics. Empty values retain the
# MPICH/libfabric defaults.
FI_PROVIDER=
FI_PROVIDER_PATH=

# Remove host OpenMPI transport selections before entering an MPICH image.
# This retains Slurm/PMI variables required by direct srun launch.
HPC_SCRUB_OPENMPI_ENV=1

# Host modules loaded by both the pipeline and MPI smoke jobs. Keep this as an
# empty Bash array when the required commands are already available.
HPC_MODULES=()

# Optional advanced site initialization that must run before HPC_MODULES.
# Most clusters do not need a separate script.
SITE_ENV_SCRIPT=

# "mpiexec" is the initial hybrid-mode recommendation. Use "srun" only after
# confirming that the container MPICH build matches the Slurm PMI plugin.
MPI_LAUNCH_MODE=mpiexec
MPI_LAUNCHER=mpiexec
SLURM_MPI_TYPE=pmi2

F77_BUILD_JOBS=4
F77_MAKE_CLEAN=1
F77_EXECUTABLE="${F77_SOURCE_CONTAINER%/}/Fourier_Quad_Pipe"
